#!/bin/sh
#
# FreeBSD rc.d service for epistula-mcp — the mail store exposed over MCP. Runs the
# Streamable HTTP transport on loopback (127.0.0.1:8786 by default) so a
# persistent / remote MCP host (e.g. a hosted chat, fronted by an authenticating
# TLS proxy) can reach it. The config carries a least-scope READ token
# (read_metadata + read_content, and NOT write_annotation). The annotate tool is
# registered only when a SEPARATE annotate_token is also configured; leave it
# empty for a read-only connector, which is the default and the safe posture
# when a model is reading attacker-supplied message bodies.
#
# Install as /usr/local/etc/rc.d/epistula_mcp (chmod 555), then:
#   sysrc epistula_mcp_enable=YES
#   service epistula_mcp start
#
# Every HTTP listener requires http_token, including loopback: other local
# processes must not inherit the configured mail-reading credential.
# Front public endpoints with a TLS reverse proxy.
#
# PROVIDE: epistula_mcp
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="epistula_mcp"
rcvar="${name}_enable"

load_rc_config $name

: ${epistula_mcp_enable:="NO"}
: ${epistula_mcp_config:="/usr/local/etc/epistula/epistula-mcp.toml"}
: ${epistula_mcp_addr:="127.0.0.1:8786"}
: ${epistula_mcp_user:="epistula-mcp"}
: ${epistula_mcp_logfile:="/var/log/epistula-mcp.log"}
: ${epistula_mcp_rundir:="/var/run/epistula-mcp"}

epistula_mcp_program="/usr/local/bin/epistula-mcp"

# daemon(8) drops to the service user and tracks the child without restarting
# permanent configuration failures. status/stop use its pidfiles.
command="/usr/sbin/daemon"
procname="${epistula_mcp_program}"
pidfile="${epistula_mcp_rundir}/${name}.pid"
supervisor_pidfile="${epistula_mcp_rundir}/supervisor.pid"

start_cmd="${name}_start"
stop_cmd="${name}_stop"

epistula_mcp_start() {
	if ! su -m "${epistula_mcp_user}" -c 'test -r "$1"' sh "${epistula_mcp_config}"; then
		echo "epistula-mcp: config not readable by ${epistula_mcp_user}: ${epistula_mcp_config}" >&2
		return 1
	fi
	if [ -f "${pidfile}" ] && pgrep -F "${pidfile}" "epistula-mcp" >/dev/null 2>&1; then
		echo "epistula-mcp already running? (pid=$(cat ${pidfile}))."
		return 1
	fi
	install -d -o "${epistula_mcp_user}" -g "${epistula_mcp_user}" -m 0755 "${epistula_mcp_rundir}"
	if [ ! -f "${epistula_mcp_logfile}" ]; then
		install -o "${epistula_mcp_user}" -g "${epistula_mcp_user}" -m 640 /dev/null "${epistula_mcp_logfile}" || return 1
	fi
	chown "${epistula_mcp_user}:${epistula_mcp_user}" "${epistula_mcp_logfile}" || return 1
	chmod 640 "${epistula_mcp_logfile}" || return 1
	echo "Starting epistula-mcp."
	/usr/sbin/daemon -f \
		-P "${supervisor_pidfile}" -p "${pidfile}" \
		-u "${epistula_mcp_user}" -o "${epistula_mcp_logfile}" \
		"${epistula_mcp_program}" -config "${epistula_mcp_config}" -http "${epistula_mcp_addr}"
}

epistula_mcp_stop() {
	# Signal the supervisor to forward shutdown, but only after checking
	# that its pidfile names a live daemon(8): a stale pidfile must not send
	# TERM to, or wait on, a reused unrelated PID. With the supervisor gone,
	# signal a surviving child directly.
	_child="$(cat ${pidfile} 2>/dev/null)"
	_supervisor="$(cat ${supervisor_pidfile} 2>/dev/null)"
	if [ -n "${_supervisor}" ] && pgrep -F "${supervisor_pidfile}" daemon >/dev/null 2>&1; then
		echo "Stopping epistula-mcp."
		kill -TERM "${_supervisor}" 2>/dev/null
	elif [ -n "${_child}" ] && pgrep -F "${pidfile}" epistula-mcp >/dev/null 2>&1; then
		echo "Stopping epistula-mcp (supervisor absent; signalling child directly)."
		kill -TERM "${_child}" 2>/dev/null
		_supervisor=""
	else
		echo "epistula-mcp not running."
		return 0
	fi
	# Wait for the supervisor too, not only the child. daemon(8) outlives the
	# child briefly while it unwinds and keeps its pidfiles locked until it
	# exits, so a `restart` whose start ran in that window failed with
	# "process already running" and left the service down.
	wait_for_pids ${_child} ${_supervisor}
}

run_rc_command "$1"
