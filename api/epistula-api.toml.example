# epistula-api.toml.example
# Copy to /usr/local/etc/epistula/epistula-api.toml and edit.

production = false

[server]
# Explicit one-hop X-Forwarded-For trust; enable only for your reverse proxy.
trusted_proxies = []
# Example: trusted_proxies = ["127.0.0.1/32", "::1/128"]
# JSON API listener. Plain HTTP; Apache terminates TLS (and optional mTLS)
# in front. Loopback only — enforced when production = true.
listen_addr              = "127.0.0.1:8784"
read_timeout_seconds     = 30
# 0 = unlimited: /v1/export streams are legitimately long-lived. Apache
# fronts this listener and owns client-liveness enforcement.
write_timeout_seconds    = 0
idle_timeout_seconds     = 120
shutdown_timeout_seconds = 30

[admin]
# Plaintext HTTP for /metrics, /health, /healthz. Loopback only.
listen_addr              = "127.0.0.1:8785"
expose_metrics           = true
read_timeout_seconds     = 5
write_timeout_seconds    = 10
shutdown_timeout_seconds = 30

[postgres]
# Same database as epistula-database. Recommended: a dedicated least-privilege
# role holding exactly the grants in deploy/README.md — SELECT on the read
# tables, SELECT + UPDATE(last_used_at) on api_tokens, SELECT/INSERT/UPDATE on
# message_annotations and message_classifications, SELECT/DELETE on
# annotation_pass_required, and EXECUTE on mail_lock_message_for_annotation.
# password: openssl rand 24 | base64 | sed 's/[/10lO#+=]//g'
# For a local Unix socket instead: host=/var/run/postgresql dbname=epistula_database user=epistula_api
# TCP production connections require sslmode=verify-full.
dsn               = "postgres://epistula_api:<generated>@127.0.0.1:5432/epistula_database?sslmode=disable"
statement_timeout = "10s"
max_open_conns    = 20
max_idle_conns    = 5     # connections kept warm (maps to pgx MinConns)
conn_max_lifetime = "5m"

[storage]
# Must match epistula-database's storage.root. Daemon needs group-read on raw/.
root = "/var/spool/epistula-database"

[limits]
# Maximum time without export write progress; 0s disables the bound.
# export_write_stall = "30m"
# Retained bytes per response page (32 MiB).
# max_page_bytes = 33554432
default_page_size    = 50
max_page_size        = 500
max_export_streams   = 2
export_page_size     = 500      # internal batch size for /v1/export
auth_fail_limit      = 10       # failed authentications per IP per window
auth_fail_window     = "60s"
auth_fail_delay      = "250ms"  # fixed delay on a failed verification
auth_cache_ttl       = "60s"    # verified-token cache; bounds revocation lag
max_annotation_bytes = 262144   # 256 KiB cap on the annotation PUT body
per_token_rate       = 0        # per-token request rate (req/s); 0 disables. Set well above a worker's rate, e.g. 50.
per_token_burst      = 100      # token-bucket capacity when per_token_rate > 0

[logging]
level  = "info"   # debug | info | warn | error
format = "text"   # text | json

[submission]
# Optional relay from POST /v1/mailboxes/{name}/submissions to the MTA's
# authenticated submission service (RFC 6409). Off until at least one
# [[submission.accounts]] entry exists; until then the endpoint answers 503.
# The MTA still authenticates the account, checks the envelope sender, signs
# and delivers; epistula-api sends the message bytes unchanged.
#
# host:port of the submission service. STARTTLS is required and the
# certificate is verified against tls_server_name (default: the host here,
# which must then be a name). On the MTA host itself, loopback works:
# address = "127.0.0.1:587" with tls_server_name set to the certificate's name.
address           = "127.0.0.1:587"
tls_server_name   = "smtp.your-domain.invalid"
timeout           = "20s"      # whole SMTP session; keep below every client's deadline
max_message_bytes = 10240000   # Postfix's default message_size_limit
max_recipients    = 50
messages_per_hour = 20         # per-token budget; 0 disables

# One entry per mailbox that may send. A token needs submit_message and the
# mailbox in its scope, and every envelope sender, From and Sender address
# must be one of the mailbox's own aliases:
#
#   epistula-database admin api-token-add -name epistula-mcp-send \
#       -mailboxes "jdoe" -permission submit_message
#
# The password is the account's submission (SASL) password. This file then
# holds a secret: root:epistula-api 0640.
#
# [[submission.accounts]]
# mailbox  = "jdoe"
# username = "jdoe"   # SASL username; defaults to mailbox
# password = ""
